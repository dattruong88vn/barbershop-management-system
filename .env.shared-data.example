# Shared Data DB (Supabase project riêng, không dùng Barbershop DB)

# Transaction pooler - dùng cho sync/runtime script, port 6543
SHARED_DATABASE_URL="postgresql://postgres.[shared-project-ref]:[password]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler - dùng cho Prisma migration, port 5432
SHARED_DIRECT_URL="postgresql://postgres.[shared-project-ref]:[password]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

LOCATION_PROVINCES_SOURCE_URL="https://provinces.open-api.vn/api/v2/p/"
LOCATION_WARDS_SOURCE_URL="https://provinces.open-api.vn/api/v2/w/"
LOCATION_SOURCE_NAME="provinces-open-api-v2"
LOCATION_SOURCE_VERSION="2025-07-01"
