{
  "name": "barbershop-management-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "npm run reference:generate && next dev",
    "build": "npm run reference:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "smoke:all": "tsx --env-file=.env.local scripts/smoke/run-all.ts",
    "smoke:auth": "tsx --env-file=.env.local scripts/smoke/auth-flow.ts",
    "smoke:dashboard": "tsx --env-file=.env.local scripts/smoke/dashboard-flow.ts",
    "smoke:management": "tsx --env-file=.env.local scripts/smoke/management-flow.ts",
    "smoke:ui:manager-branch": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test scripts/smoke/playwright/manager-branch-ui.spec.mjs --browser=chromium --reporter=line",
    "smoke:ui:staff-form": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test scripts/smoke/playwright/staff-form-ui.spec.mjs --browser=chromium --reporter=line",
    "smoke:ui:visits": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test scripts/smoke/playwright/visit-ui.spec.mjs --browser=chromium --reporter=line",
    "smoke:visits": "tsx --env-file=.env.local scripts/smoke/visit-flow.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "reference:generate": "prisma generate --schema prisma/reference-data.prisma",
    "shared:generate": "prisma generate --config infrastructure/shared-location-db/prisma.config.ts",
    "shared:migrate": "prisma migrate deploy --config infrastructure/shared-location-db/prisma.config.ts",
    "shared:sync-location": "tsx --env-file=.env.shared-data infrastructure/shared-location-db/sync.ts",
    "shared:verify-location": "tsx --env-file=.env.shared-data infrastructure/shared-location-db/verify.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1064.0",
    "@aws-sdk/s3-request-presigner": "^3.1064.0",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.100.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "nanoid": "^5.1.11",
    "next": "16.2.6",
    "next-auth": "^4.24.14",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/next-auth": "^3.13.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
