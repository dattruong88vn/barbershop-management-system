generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ShopPlan {
  basic
  pro
  pro_max
}

enum ShopStatus {
  active
  expired
}

enum UserRole {
  superadmin
  owner
  manager
  receptionist
  barber
  skinner
}

enum UserStatus {
  active
  inactive
}

enum VisitStatus {
  pending
  in_progress
  completed
}

enum ServiceResponsibleRole {
  barber
  skinner
}

model Shop {
  id             String     @id @default(uuid()) @db.Uuid
  name           String
  address        String
  plan           ShopPlan   @default(basic)
  status         ShopStatus @default(active)
  trialExpiresAt DateTime   @map("trial_expires_at") @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  branches      Branch[]
  users         User[]
  services      Service[]
  combos        Combo[]
  comboServices ComboService[]
  customers     Customer[]
  visits        Visit[]
  visitServices VisitService[]
  visitPhotos   VisitPhoto[]

  @@map("shops")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  name      String
  address   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  users    User[]
  services Service[]
  combos   Combo[]
  visits   Visit[]

  @@index([shopId])
  @@map("branches")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  shopId       String?    @map("shop_id") @db.Uuid
  branchId     String?    @map("branch_id") @db.Uuid
  username     String
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(active)
  isFirstLogin Boolean    @default(true) @map("is_first_login")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  shop              Shop?        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  branch            Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  barberVisits      Visit[]      @relation("VisitBarber")
  skinnerVisits     Visit[]      @relation("VisitSkinner")
  createdVisits     Visit[]      @relation("VisitCreatedBy")
  createdServices   Service[]    @relation("ServiceCreatedBy")
  createdCombos     Combo[]      @relation("ComboCreatedBy")
  lastUpdatedVisits Visit[]      @relation("VisitLastUpdatedBy")
  uploadedPhotos    VisitPhoto[] @relation("VisitPhotoUploadedBy")

  @@unique([shopId, username])
  @@index([branchId])
  @@map("users")
}

model Service {
  id              String                 @id @default(uuid()) @db.Uuid
  shopId          String                 @map("shop_id") @db.Uuid
  branchId        String?                @map("branch_id") @db.Uuid
  name            String
  price           Decimal                @db.Decimal(12, 2)
  responsibleRole ServiceResponsibleRole @map("responsible_role")
  isHaircut       Boolean                @default(false) @map("is_haircut")
  createdBy       String                 @map("created_by") @db.Uuid
  deletedAt       DateTime?              @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  creator       User           @relation("ServiceCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  comboServices ComboService[]
  visitServices VisitService[]

  @@index([shopId])
  @@index([shopId, deletedAt])
  @@index([shopId, branchId])
  @@index([branchId])
  @@index([createdBy])
  @@map("services")
}

model Combo {
  id          String    @id @default(uuid()) @db.Uuid
  shopId      String    @map("shop_id") @db.Uuid
  branchId    String?   @map("branch_id") @db.Uuid
  name        String
  description String
  price       Decimal   @db.Decimal(12, 2)
  createdBy   String    @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  creator       User           @relation("ComboCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  comboServices ComboService[]
  visitServices VisitService[]

  @@index([shopId])
  @@index([shopId, deletedAt])
  @@index([shopId, branchId])
  @@index([branchId])
  @@index([createdBy])
  @@map("combos")
}

model ComboService {
  id        String @id @default(uuid()) @db.Uuid
  shopId    String @map("shop_id") @db.Uuid
  comboId   String @map("combo_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  combo   Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([comboId, serviceId])
  @@index([shopId])
  @@index([serviceId])
  @@map("combo_services")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  name      String
  phone     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  visits Visit[]

  @@unique([shopId, phone])
  @@index([shopId])
  @@map("customers")
}

model Visit {
  id               String      @id @default(uuid()) @db.Uuid
  shopId           String      @map("shop_id") @db.Uuid
  customerId       String      @map("customer_id") @db.Uuid
  branchId         String      @map("branch_id") @db.Uuid
  barberId         String?     @map("barber_id") @db.Uuid
  skinnerId        String?     @map("skinner_id") @db.Uuid
  noHaircut        Boolean     @default(false) @map("no_haircut")
  noSkinnerService Boolean     @default(false) @map("no_skinner_service")
  status           VisitStatus @default(pending)
  totalPrice       Decimal     @map("total_price") @db.Decimal(12, 2)
  createdBy        String      @map("created_by") @db.Uuid
  completedAt      DateTime?   @map("completed_at") @db.Timestamptz(6)
  lastUpdatedBy    String?     @map("last_updated_by") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  shop          Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  barber        User?          @relation("VisitBarber", fields: [barberId], references: [id], onDelete: SetNull)
  skinner       User?          @relation("VisitSkinner", fields: [skinnerId], references: [id], onDelete: SetNull)
  creator       User           @relation("VisitCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  lastUpdater   User?          @relation("VisitLastUpdatedBy", fields: [lastUpdatedBy], references: [id], onDelete: SetNull)
  visitServices VisitService[]
  visitPhotos   VisitPhoto[]

  @@index([shopId])
  @@index([customerId])
  @@index([branchId])
  @@index([barberId])
  @@index([skinnerId])
  @@index([createdBy])
  @@index([lastUpdatedBy])
  @@map("visits")
}

model VisitService {
  id                      String                  @id @default(uuid()) @db.Uuid
  shopId                  String                  @map("shop_id") @db.Uuid
  visitId                 String                  @map("visit_id") @db.Uuid
  serviceId               String?                 @map("service_id") @db.Uuid
  comboId                 String?                 @map("combo_id") @db.Uuid
  price                   Decimal                 @db.Decimal(12, 2)
  serviceNameSnapshot     String?                 @map("service_name_snapshot")
  servicePriceSnapshot    Decimal?                @map("service_price_snapshot") @db.Decimal(12, 2)
  comboNameSnapshot       String?                 @map("combo_name_snapshot")
  comboPriceSnapshot      Decimal?                @map("combo_price_snapshot") @db.Decimal(12, 2)
  responsibleRoleSnapshot ServiceResponsibleRole? @map("responsible_role_snapshot")
  allocatedPrice          Decimal                 @map("allocated_price") @db.Decimal(12, 2)

  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  visit   Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  combo   Combo?   @relation(fields: [comboId], references: [id], onDelete: Restrict)

  @@index([shopId])
  @@index([visitId])
  @@index([serviceId])
  @@index([comboId])
  @@index([responsibleRoleSnapshot])
  @@map("visit_services")
}

model VisitPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  shopId     String   @map("shop_id") @db.Uuid
  visitId    String   @map("visit_id") @db.Uuid
  photoUrl   String   @map("photo_url")
  uploadedBy String   @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shop     Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  visit    Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  uploader User  @relation("VisitPhotoUploadedBy", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([shopId])
  @@index([visitId])
  @@index([uploadedBy])
  @@map("visit_photos")
}
