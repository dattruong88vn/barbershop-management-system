# Shared Location DB (Supabase project riêng, không dùng Barbershop DB)

# Transaction pooler - dùng cho sync/runtime script, port 6543
LOCATION_DATABASE_URL="postgresql://postgres.[shared-project-ref]:[password]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler - dùng cho Prisma migration, port 5432
LOCATION_DIRECT_URL="postgresql://postgres.[shared-project-ref]:[password]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

LOCATION_PROVINCES_SOURCE_URL="https://huynhminhvangit.github.io/vn-region-api/data/provinces.json"
LOCATION_WARDS_SOURCE_URL="https://huynhminhvangit.github.io/vn-region-api/data/wards.json"
LOCATION_SOURCE_NAME="vn-region-api"
LOCATION_SOURCE_VERSION="2025-07-01"
