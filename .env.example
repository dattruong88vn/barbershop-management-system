# Environment Variables

# Database (Supabase)

# Transaction pooler - used for queries (port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[pooler-host].supabase.com:6543/postgres?pgbouncer=true"

# Session pooler - used for migrations (port 5432)
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@[pooler-host].supabase.com:5432/postgres"
